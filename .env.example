# All variables are optional. Without them the app runs the full credential-free demo.

# Server-side only. Enables Gemini document interpretation in /api/extract.
# Never prefix with NEXT_PUBLIC_. Students must also opt in to external AI processing.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=
# Optional request timeout in ms (default: 20000)
GEMINI_TIMEOUT_MS=
